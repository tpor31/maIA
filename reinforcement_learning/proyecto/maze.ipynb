    "            ax.text(col + 0.5, fila + 0.5, 'E', ha = 'center', va = 'center', fontsize = 10, color = 'darkgreen', weight = 'bold')\n",
    "        \n",
    "        # Dibujar salidas (rojo claro)\n",
    "        for salida in self.exit:\n",
