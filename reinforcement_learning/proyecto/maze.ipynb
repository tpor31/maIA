    "    def load_policy(self, filename: str) -> None:\n",
    "        \"\"\"Carga la tabla Q desde un archivo json.\"\"\"\n",
    "        df = pd.read_json(filename, orient = 'records', lines = True)\n",
    "        self.qtable = {}\n",
    "        for _, row in df.iterrows():\n",
    "            state = tuple(row['state'])\n",
    "            action = row['action']\n",
    "            value = row['value']\n",
